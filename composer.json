{
    "name": "fof/anti-spam",
    "description": "Effective tools to manage spammers on your community.",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/anti-spam/issues",
        "source": "https://github.com/FriendsOfFlarum/anti-spam",
        "forum": "https://discuss.flarum.org/d/33698"
    },
    "homepage": "https://friendsofflarum.org",
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "require": {
        "flarum/core": "2.x-dev",
        "flarum/approval": "^2.1.0-beta.1",
        "flarum/flags": "^2.1.0-beta.1"
    },
    "authors": [
        {
            "name": "IanM",
            "email": "ian@flarum.org",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\AntiSpam\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF Anti Spam",
            "category": "feature",
            "icon": {
                "name": "fas fa-shield-alt",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/suspend",
                "flarum/tags",
                "flarum/audit",
                "fof/masquerade"
            ]
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": true,
                "editorConfig": true,
                "styleci": true
            }
        },
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "FoF\\AntiSpam\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:unit:filter": "phpunit -c tests/phpunit.unit.xml --filter",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:integration:filter": "phpunit -c tests/phpunit.integration.xml --filter",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis",
        "test:unit:filter": "Runs unit tests whose name matches: composer test:unit:filter -- ClassName",
        "test:integration:filter": "Runs integration tests whose name matches: composer test:integration:filter -- ClassName"
    },
    "require-dev": {
        "flarum/testing": "^2.1.0-beta.1",
        "flarum/phpstan": "^2.1.0-beta.1",
        "flarum/suspend": "^2.1.0-beta.1",
        "fof/user-bio": "^2.0.0",
        "flarum/tags": "^2.1.0-beta.1",
        "fof/oauth": "^2.0.0",
        "flarum/realtime": "^2.1.0-beta.1",
        "flarum/audit": "^2.1.0-beta.1",
        "flarum/markdown": "^2.1.0-beta.1",
        "flarum/nicknames": "^2.1.0-beta.1",
        "fof/masquerade": "^3.0"
    },
    "suggest": {
        "flarum/audit": "Records spamblocks, so the dashboard widget can report users marked as spammers.",
        "flarum/suspend": "Suspends a spammer's account instead of leaving it active when they are marked.",
        "flarum/nicknames": "Checks nicknames for spam content, as usernames already are.",
        "fof/user-bio": "Checks bios for spam content, and clears them when a user is marked as a spammer."
    }
}
